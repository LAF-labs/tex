{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign-ax.local/schemas/docparse-result-v1.json",
  "title": "@sax/docparse parse(bytes, kind) 결과(sax.docparse/v1). 판정 없이 추출값·신뢰도·경고만. 증명서 result는 docmeta-extract-v1(@sax/engine/docmeta)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "result", "confidence", "warnings", "needsManual", "source", "text"],
  "properties": {
    "schema": { "const": "sax.docparse/v1" },
    "kind": { "enum": ["certificate", "receipt", "settlement", "insurance_notice"] },
    "result": { "type": "object" },
    "confidence": { "$ref": "#/definitions/unit" },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "enum": ["ocr_used", "low_ocr_confidence", "scanned_text_layer", "pages_truncated", "formula_cached_values", "external_links_ignored", "macros_ignored", "connections_ignored", "embedded_ignored", "hidden_sheets_skipped", "hidden_rows_skipped", "sheet_truncated", "formula_like_text", "format_estimated", "channel_mismatch", "total_mismatch", "rrn_full_masked", "exif_present", "multiple_biz_no", "amount_cross_check_failed", "header_not_found", "no_rows", "encoding_euc_kr", "core_fields_missing"]
      }
    },
    "needsManual": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "textLayer", "ocr", "ocrConfidence", "pages", "image"],
      "properties": {
        "format": { "enum": ["pdf", "jpeg", "png", "xlsx", "csv"] },
        "textLayer": { "type": ["boolean", "null"] },
        "ocr": { "type": "boolean" },
        "ocrConfidence": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "pages": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 5 }, { "type": "null" }] },
        "image": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }
          ]
        }
      }
    },
    "text": { "type": "string", "maxLength": 65536 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "certificate" } } }, "then": { "properties": { "result": { "$ref": "https://sovereign-ax.local/schemas/docmeta-extract-v1.json" } } } },
    { "if": { "properties": { "kind": { "const": "receipt" } } }, "then": { "properties": { "result": { "$ref": "#/definitions/receipt" } } } },
    { "if": { "properties": { "kind": { "const": "settlement" } } }, "then": { "properties": { "result": { "$ref": "#/definitions/settlement" } } } },
    { "if": { "properties": { "kind": { "const": "insurance_notice" } } }, "then": { "properties": { "result": { "$ref": "#/definitions/insuranceNotice" } } } }
  ],
  "definitions": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "isoDate": { "type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "won": { "type": "integer", "minimum": -100000000000, "maximum": 100000000000 },
    "reason": { "enum": ["not_found", "ambiguous", "checksum_failed", "unparseable", null] },
    "fieldOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "reason"],
      "properties": { "value": {}, "confidence": { "$ref": "#/definitions/unit" }, "reason": { "$ref": "#/definitions/reason" }, "candidates": { "type": "array", "minItems": 1, "maxItems": 6 } },
      "oneOf": [
        { "properties": { "value": { "not": { "type": "null" } }, "reason": { "type": "null" } } },
        { "properties": { "value": { "type": "null" }, "reason": { "type": "string" }, "confidence": { "const": 0 } } }
      ]
    },
    "dateField": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }] }, "candidates": { "items": { "$ref": "#/definitions/isoDate" } } } }] },
    "wonField": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "$ref": "#/definitions/won" }, { "type": "null" }] }, "candidates": { "items": { "$ref": "#/definitions/won" } } } }] },
    "textField": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "type": ["string", "null"], "maxLength": 60 }, "candidates": { "items": { "type": "string", "maxLength": 60 } } } }] },
    "bizNoField": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "type": "string", "pattern": "^\\d{10}$" }, { "type": "null" }] }, "candidates": { "items": { "type": "string", "pattern": "^\\d{10}$" } } } }] },
    "digitsField": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "type": "string", "pattern": "^\\d{4,10}$" }, { "type": "null" }] } } }] },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "docKind", "issuedOn", "merchant", "merchantBizNo", "amount", "supplyAmount", "vat", "approvalNo", "cardTail"],
      "properties": {
        "extractor": { "const": "receipt-v1" },
        "docKind": { "enum": ["card_slip", "cash_receipt", "simple_receipt", "receipt", "tax_invoice", "invoice", "unknown"] },
        "issuedOn": { "$ref": "#/definitions/dateField" },
        "merchant": { "$ref": "#/definitions/textField" },
        "merchantBizNo": { "$ref": "#/definitions/bizNoField" },
        "amount": { "$ref": "#/definitions/wonField" },
        "supplyAmount": { "$ref": "#/definitions/wonField" },
        "vat": { "$ref": "#/definitions/wonField" },
        "approvalNo": { "$ref": "#/definitions/digitsField" },
        "cardTail": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}$" }, { "type": "null" }] } } }] }
      }
    },
    "nullableWon": { "anyOf": [{ "$ref": "#/definitions/won" }, { "type": "null" }] },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "channel", "platform", "profile", "estimated", "sheet", "headerRow", "columns", "period", "rows", "totals", "fileTotals"],
      "properties": {
        "extractor": { "const": "settlement-v1" },
        "channel": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "enum": ["delivery", "market", null] } } }] },
        "platform": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "enum": ["baemin", "coupang_eats", "yogiyo", "ddangyo", "smartstore", "coupang", "11st", "esm", "other", null] } } }] },
        "profile": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
        "estimated": { "type": "boolean" },
        "sheet": { "type": "string", "maxLength": 64 },
        "headerRow": { "type": "integer", "minimum": 0 },
        "columns": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "index", "header"],
            "properties": { "role": { "enum": ["date", "order_id", "order_count", "gross", "fee", "payout", "vat", "discount"] }, "index": { "type": "integer", "minimum": 0, "maximum": 255 }, "header": { "type": "string", "maxLength": 80 } }
          }
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": { "from": { "anyOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }] }, "to": { "anyOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }] } }
        },
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "gross", "fees", "payout", "vat", "orderCount"],
            "properties": {
              "date": { "anyOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }] },
              "gross": { "$ref": "#/definitions/nullableWon" },
              "fees": { "$ref": "#/definitions/nullableWon" },
              "payout": { "$ref": "#/definitions/nullableWon" },
              "vat": { "$ref": "#/definitions/nullableWon" },
              "orderCount": { "$ref": "#/definitions/nullableWon" }
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gross", "fees", "payout", "vat", "rows"],
          "properties": { "gross": { "$ref": "#/definitions/nullableWon" }, "fees": { "$ref": "#/definitions/nullableWon" }, "payout": { "$ref": "#/definitions/nullableWon" }, "vat": { "$ref": "#/definitions/nullableWon" }, "rows": { "type": "integer", "minimum": 0 } }
        },
        "fileTotals": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["gross", "fees", "payout"],
              "properties": { "gross": { "$ref": "#/definitions/nullableWon" }, "fees": { "$ref": "#/definitions/nullableWon" }, "payout": { "$ref": "#/definitions/nullableWon" } }
            }
          ]
        }
      }
    },
    "insuranceKind": { "enum": ["pension", "health", "ltc", "employment", "industrial"] },
    "insuranceNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "estimated", "profile", "month", "insurances", "rows"],
      "properties": {
        "extractor": { "const": "insurance-notice-v1" },
        "estimated": { "type": "boolean" },
        "profile": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
        "month": { "allOf": [{ "$ref": "#/definitions/fieldOf" }, { "properties": { "value": { "anyOf": [{ "type": "string", "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$" }, { "type": "null" }] } } }] },
        "insurances": { "type": "array", "uniqueItems": true, "maxItems": 5, "items": { "$ref": "#/definitions/insuranceKind" } },
        "rows": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rowId", "name", "birthDate", "rrnFront7", "insurance", "base", "total", "employee", "employer", "confidence"],
            "properties": {
              "rowId": { "type": "string", "maxLength": 120 },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "birthDate": { "anyOf": [{ "type": "string", "pattern": "^(18|19|20)\\d{2}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
              "rrnFront7": { "anyOf": [{ "type": "string", "pattern": "^\\d{7}$" }, { "type": "null" }] },
              "insurance": { "$ref": "#/definitions/insuranceKind" },
              "base": { "$ref": "#/definitions/nullableWon" },
              "total": { "$ref": "#/definitions/nullableWon" },
              "employee": { "$ref": "#/definitions/nullableWon" },
              "employer": { "$ref": "#/definitions/nullableWon" },
              "confidence": { "$ref": "#/definitions/unit" }
            }
          }
        }
      }
    }
  }
}
