{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-ax.local/schemas/rate-table-package.schema.json",
  "title": "시행일 표 데이터 패키지 (D14 M6-10, ADR-031 결정 5)",
  "description": "급여 계산 보조 표(근로소득 간이세액표·4대보험 요율·국민연금 기준소득월액 상·하한·비과세 한도). 서명·배포는 레지스트리 채널(M4-7)이 하고, 이 스키마는 서명 안의 본문 형태만 정한다. 요율은 백만분율(ppm, 1% = 10000), 금액은 원 단위 정수.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packageVersion", "tables"],
  "properties": {
    "schema": { "const": "sax.rate-tables/v1" },
    "packageVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,3}$" },
    "tables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/table" } }
  },
  "$defs": {
    "won": { "type": "integer", "minimum": 0, "maximum": 100000000000 },
    "ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "day": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "rounding": { "enum": ["floor_1", "floor_10", "floor_100", "floor_1000", "round_1", "round_10"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": { "title": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" } }
    },
    "meta": {
      "type": "object",
      "required": ["id", "kind", "effectiveFrom", "effectiveTo", "rounding", "review", "sources", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "effectiveFrom": { "$ref": "#/$defs/day" },
        "effectiveTo": { "oneOf": [{ "$ref": "#/$defs/day" }, { "type": "null" }] },
        "rounding": { "$ref": "#/$defs/rounding" },
        "review": { "enum": ["confirmed", "needs_review"] },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "note": { "type": "string" }
      }
    },
    "table": {
      "allOf": [{ "$ref": "#/$defs/meta" }],
      "oneOf": [
        { "properties": { "kind": { "const": "simple_tax_table" }, "body": { "$ref": "#/$defs/simpleTax" } } },
        { "properties": { "kind": { "const": "insurance_rate" }, "body": { "$ref": "#/$defs/insurance" } } },
        { "properties": { "kind": { "const": "pension_bounds" }, "body": { "$ref": "#/$defs/pensionBounds" } } },
        { "properties": { "kind": { "const": "nontax_limits" }, "body": { "$ref": "#/$defs/nontax" } } }
      ],
      "unevaluatedProperties": false
    },
    "simpleTax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "over", "children", "familyOver11"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/won" } }
        },
        "over": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "brackets"],
          "properties": {
            "top": { "$ref": "#/$defs/won" },
            "brackets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["above", "addWon", "num", "den"],
                "properties": {
                  "above": { "$ref": "#/$defs/won" },
                  "addWon": { "$ref": "#/$defs/won" },
                  "num": { "type": "integer", "minimum": 0 },
                  "den": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amounts", "extraPerChild"],
          "properties": {
            "amounts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/won" }, "prefixItems": [{ "const": 0 }] },
            "extraPerChild": { "$ref": "#/$defs/won" }
          }
        },
        "familyOver11": { "const": "extrapolate_10_11" }
      }
    },
    "insurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pension", "health", "ltc", "employment"],
      "properties": {
        "pension": {
          "type": "object", "additionalProperties": false, "required": ["employeePpm", "employerPpm", "rounding"],
          "properties": { "employeePpm": { "$ref": "#/$defs/ppm" }, "employerPpm": { "$ref": "#/$defs/ppm" }, "rounding": { "$ref": "#/$defs/rounding" } }
        },
        "health": {
          "type": "object", "additionalProperties": false, "required": ["employeePpm", "employerPpm", "rounding"],
          "properties": {
            "employeePpm": { "$ref": "#/$defs/ppm" }, "employerPpm": { "$ref": "#/$defs/ppm" }, "rounding": { "$ref": "#/$defs/rounding" },
            "minBase": { "$ref": "#/$defs/won" }, "maxBase": { "$ref": "#/$defs/won" }
          }
        },
        "ltc": {
          "type": "object", "additionalProperties": false, "required": ["ratePpm", "healthRatePpm", "rounding"],
          "properties": { "ratePpm": { "$ref": "#/$defs/ppm" }, "healthRatePpm": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "rounding": { "$ref": "#/$defs/rounding" } }
        },
        "employment": {
          "type": "object", "additionalProperties": false, "required": ["employeePpm", "employerUnemploymentPpm", "employerStabilityPpm", "rounding"],
          "properties": {
            "employeePpm": { "$ref": "#/$defs/ppm" },
            "employerUnemploymentPpm": { "$ref": "#/$defs/ppm" },
            "employerStabilityPpm": {
              "type": "object", "additionalProperties": false, "required": ["under150", "priority150plus", "from150to999", "over1000"],
              "properties": {
                "under150": { "$ref": "#/$defs/ppm" }, "priority150plus": { "$ref": "#/$defs/ppm" },
                "from150to999": { "$ref": "#/$defs/ppm" }, "over1000": { "$ref": "#/$defs/ppm" }
              }
            },
            "rounding": { "$ref": "#/$defs/rounding" }
          }
        }
      }
    },
    "pensionBounds": {
      "type": "object", "additionalProperties": false, "required": ["minBase", "maxBase", "baseRounding"],
      "properties": { "minBase": { "$ref": "#/$defs/won" }, "maxBase": { "$ref": "#/$defs/won" }, "baseRounding": { "$ref": "#/$defs/rounding" } }
    },
    "nontax": {
      "type": "object", "additionalProperties": false, "required": ["kinds"],
      "properties": {
        "kinds": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "enum": ["meal", "vehicle", "childcare", "research"] },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["label", "monthlyLimit", "basis"],
            "properties": { "label": { "type": "string", "minLength": 1 }, "monthlyLimit": { "$ref": "#/$defs/won" }, "basis": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
