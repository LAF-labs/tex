{
 "ir": 2,
 "id": "hometax.invoice.lookup",
 "version": "1.0.0",
 "portal": "hometax",
 "profileKinds": [
  "business"
 ],
 "effects": [],
 "inputs": {
  "key": {
   "type": "string",
   "required": true
  }
 },
 "steps": [
  {
   "id": "s0",
   "type": "goto",
   "url": "https://hometax.go.kr/invoice/list"
  },
  {
   "id": "s1",
   "type": "wait",
   "for": "selector",
   "value": "hometax.lookup.root"
  },
  {
   "id": "s2",
   "type": "fill",
   "target": "hometax.lookup.searchKey",
   "value": "$inputs.key"
  },
  {
   "id": "s3",
   "type": "select",
   "target": "hometax.lookup.period",
   "option": "1일"
  },
  {
   "id": "s4",
   "type": "click",
   "target": "hometax.lookup.searchButton"
  },
  {
   "id": "s5",
   "type": "extract",
   "name": "rows",
   "from": {
    "a11y": {
     "target": "hometax.lookup.rows"
    }
   }
  },
  {
   "id": "s6",
   "type": "end",
   "status": "success"
  }
 ],
 "postconditions": []
}