{
 "ir": 2,
 "id": "hometax.cert.taxpayment",
 "version": "1.0.0",
 "portal": "hometax",
 "profileKinds": [
  "business"
 ],
 "effects": [
  "issue_document"
 ],
 "inputs": {
  "purpose": {
   "type": "enum",
   "required": true,
   "values": [
    "대금수령",
    "관공서 제출",
    "금융기관 제출",
    "입찰 참가",
    "해외이주",
    "기타"
   ]
  },
  "submitTo": {
   "type": "enum",
   "required": true,
   "values": [
    "관공서",
    "금융기관",
    "공공기관",
    "기타"
   ]
  }
 },
 "preconditions": [
  {
   "profileHas": "signMethod"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "type": "checkpoint",
   "name": "session",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s2",
   "type": "branch",
   "on": {
    "textMatches": {
     "target": "hometax.header.loginLink",
     "patternRef": "login.loggedIn"
    }
   },
   "cases": {
    "true": "s10"
   },
   "default": "s3"
  },
  {
   "id": "s3",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s4",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.certTab",
   "timeoutMs": 30000
  },
  {
   "id": "s4a",
   "type": "click",
   "target": "hometax.login.certTab"
  },
  {
   "id": "s4b",
   "type": "click",
   "target": "hometax.login.certOpen"
  },
  {
   "id": "s4c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.table",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8",
   "type": "click",
   "target": "hometax.cert.storageHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8a",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.driveHdd",
   "timeoutMs": 15000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8b",
   "type": "click",
   "target": "hometax.cert.driveHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4d",
   "type": "pick",
   "target": "hometax.cert.table",
   "by": "$profile.certName",
   "ifNone": "s4e",
   "then": "s4g",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4e",
   "type": "handoff",
   "reason": "cert.pickOne",
   "resumeAt": "s4f",
   "code": "cert.pick_needed"
  },
  {
   "id": "s4f",
   "type": "pick",
   "target": "hometax.cert.table",
   "use": "selected",
   "remember": "certName",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s4g",
   "type": "human",
   "kind": "secret",
   "target": "hometax.cert.password",
   "prompt": "cert.passwordPrompt",
   "ttlMs": 120000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4h",
   "type": "click",
   "target": "hometax.cert.loginConfirm",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s5",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s6",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s7",
   "type": "checkpoint",
   "name": "simple_login",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "reentry": "reload"
  },
  {
   "id": "s7a",
   "type": "goto",
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml"
  },
  {
   "id": "s7b",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s7c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.simpleTab",
   "timeoutMs": 30000
  },
  {
   "id": "s7d",
   "type": "click",
   "target": "hometax.login.simpleTab"
  },
  {
   "id": "s7e",
   "type": "handoff",
   "reason": "login.simpleAuth",
   "resumeAt": "s7f",
   "code": "login.simple_auth"
  },
  {
   "id": "s7f",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s7g",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s10",
   "type": "goto",
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml&tmIdx=43&tm2lIdx=4315010000&tm3lIdx=4315010300"
  },
  {
   "id": "s11",
   "type": "checkpoint",
   "name": "form",
   "expect": {
    "any": [
     {
      "exists": "hometax.cert.taxpayment.form.root"
     },
     {
      "exists": "hometax.cert.alert"
     }
    ]
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml&tmIdx=43&tm2lIdx=4315010000&tm3lIdx=4315010300",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s11a",
   "type": "assert",
   "cond": {
    "not": {
     "textMatches": {
      "target": "hometax.cert.alert",
      "patternRef": "cert.block.personalOnly"
     }
    }
   },
   "code": "portal.personal_login_required",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s11b",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.taxpayment.form.root"
  },
  {
   "id": "s12",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.purpose",
   "option": "$inputs.purpose"
  },
  {
   "id": "s13",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.submitTo",
   "option": "$inputs.submitTo"
  },
  {
   "id": "s14",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.residentNoDisclosure",
   "option": "공개안함"
  },
  {
   "id": "s19",
   "type": "decide",
   "bundle": "form_ready_v2",
   "scope": "hometax.cert.taxpayment.form.root",
   "on": {
    "no_visible_error": "s19a",
    "validation_error": "handoff",
    "unknown": "handoff"
   }
  },
  {
   "id": "s19a",
   "type": "assert",
   "cond": {
    "fieldsFilled": {
     "fields": [
      "supplierBizNo",
      "certDoc",
      "certPurpose",
      "certSubmitTo"
     ]
    }
   }
  },
  {
   "id": "s19b",
   "type": "readback",
   "fields": [
    "supplierBizNo",
    "applicantName",
    "certDoc",
    "certPurpose",
    "certSubmitTo",
    "rrnDisclosure",
    "copies"
   ]
  },
  {
   "id": "s19c",
   "type": "assert",
   "cond": {
    "readbackEquals": {
     "fieldKey": "supplierBizNo",
     "ref": "$profile.bizNo"
    }
   },
   "code": "assert.supplier_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s19d",
   "type": "assert",
   "cond": {
    "textMatches": {
     "target": "hometax.cert.taxpayment.form.certDoc",
     "patternRef": "cert.doc.taxpayment"
    }
   },
   "code": "assert.input_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s19f",
   "type": "assert",
   "cond": {
    "all": [
     {
      "readbackEquals": {
       "fieldKey": "certPurpose",
       "ref": "$inputs.purpose"
      }
     },
     {
      "readbackEquals": {
       "fieldKey": "certSubmitTo",
       "ref": "$inputs.submitTo"
      }
     }
    ]
   },
   "code": "assert.input_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s20",
   "type": "gate",
   "card": "cert.confirm",
   "authorizes": [
    "s21"
   ],
   "waitMs": 600000
  },
  {
   "id": "s21",
   "type": "submit",
   "target": "hometax.cert.taxpayment.form.applyButton",
   "intent": "$intent.id",
   "verify": "s30",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s30",
   "type": "verify",
   "lookup": {
    "playbook": "hometax.cert.issued_list",
    "match": {
     "certDoc": "$readback.certDoc"
    },
    "window": "today",
    "baseline": "pre_gate_snapshot",
    "notCommittedPolicy": {
     "minElapsedMs": 60000,
     "lookups": 2
    },
    "bind": {
     "approvalNo": "issueNo"
    }
   },
   "on": {
    "committed": "s31",
    "not_committed": "s11",
    "unknown": "handoff"
   }
  },
  {
   "id": "s31",
   "type": "click",
   "target": "hometax.cert.taxpayment.result.printButton"
  },
  {
   "id": "s32",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.taxpayment.doc.root",
   "timeoutMs": 30000
  },
  {
   "id": "s33",
   "type": "save_pdf",
   "strategy": "print",
   "docType": "national_tax_cert"
  },
  {
   "id": "s34",
   "type": "end",
   "status": "success"
  }
 ],
 "postconditions": [
  {
   "varSet": "issueNo"
  },
  {
   "artifact": "pdf"
  }
 ],
 "pacing": {
  "profile": "interactive"
 },
 "closeWindows": [
  "login.certNoticeWindow"
 ],
 "closeLayers": {
  "targets": [
   "hometax.layer.btnClose",
   "hometax.layer.btnCloseAlt"
  ],
  "until": "s12"
 }
}