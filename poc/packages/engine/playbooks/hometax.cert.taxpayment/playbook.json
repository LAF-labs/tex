{
 "ir": 2,
 "id": "hometax.cert.taxpayment",
 "version": "1.0.0",
 "portal": "hometax",
 "profileKinds": [
  "business"
 ],
 "effects": [
  "issue_document"
 ],
 "inputs": {
  "purpose": {
   "type": "enum",
   "required": true,
   "values": [
    "대금수령",
    "관공서 제출",
    "금융기관 제출",
    "입찰 참가",
    "해외이주",
    "기타"
   ]
  },
  "submitTo": {
   "type": "enum",
   "required": true,
   "values": [
    "관공서",
    "금융기관",
    "공공기관",
    "기타"
   ]
  }
 },
 "preconditions": [
  {
   "profileHas": "signMethod"
  }
 ],
 "steps": [
  {
   "id": "s0",
   "type": "checkpoint",
   "name": "session",
   "expect": {
    "exists": "hometax.nav.home"
   },
   "url": "https://hometax.go.kr/",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s1",
   "type": "goto",
   "url": "https://hometax.go.kr/"
  },
  {
   "id": "s2",
   "type": "decide",
   "bundle": "screen_state_v2",
   "scope": "root",
   "loopGuard": {
    "max": 3
   },
   "on": {
    "logged_in": "s10",
    "login_required": "s3",
    "captcha": "s90",
    "mfa_pending": "s5",
    "error": "handoff",
    "unknown": "handoff"
   }
  },
  {
   "id": "s3",
   "type": "click",
   "target": "hometax.login.startButton"
  },
  {
   "id": "s4",
   "type": "sign",
   "method": "$profile.signMethod",
   "then": [
    "human:secret"
   ]
  },
  {
   "id": "s5",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 120000,
   "pace": "slow"
  },
  {
   "id": "s6",
   "type": "decide",
   "bundle": "screen_state_v2",
   "scope": "root",
   "loopGuard": {
    "max": 3
   },
   "on": {
    "logged_in": "s10",
    "login_required": "handoff",
    "captcha": "s90",
    "mfa_pending": "s5",
    "error": "handoff",
    "unknown": "handoff"
   }
  },
  {
   "id": "s10",
   "type": "goto",
   "url": "https://hometax.go.kr/cert/taxpayment"
  },
  {
   "id": "s11",
   "type": "checkpoint",
   "name": "form",
   "expect": {
    "exists": "hometax.cert.taxpayment.form.root"
   },
   "url": "https://hometax.go.kr/cert/taxpayment",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s12",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.purpose",
   "option": "$inputs.purpose"
  },
  {
   "id": "s13",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.submitTo",
   "option": "$inputs.submitTo"
  },
  {
   "id": "s14",
   "type": "select",
   "target": "hometax.cert.taxpayment.form.residentNoDisclosure",
   "option": "공개안함"
  },
  {
   "id": "s19",
   "type": "decide",
   "bundle": "form_ready_v2",
   "scope": "hometax.cert.taxpayment.form.root",
   "on": {
    "no_visible_error": "s19a",
    "validation_error": "handoff",
    "unknown": "handoff"
   }
  },
  {
   "id": "s19a",
   "type": "assert",
   "cond": {
    "fieldsFilled": {
     "fields": [
      "supplierBizNo",
      "certDoc",
      "certPurpose",
      "certSubmitTo"
     ]
    }
   }
  },
  {
   "id": "s19b",
   "type": "readback",
   "fields": [
    "supplierBizNo",
    "applicantName",
    "certDoc",
    "certPurpose",
    "certSubmitTo",
    "rrnDisclosure",
    "copies"
   ]
  },
  {
   "id": "s19c",
   "type": "assert",
   "cond": {
    "readbackEquals": {
     "fieldKey": "supplierBizNo",
     "ref": "$profile.bizNo"
    }
   },
   "code": "assert.supplier_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s19d",
   "type": "assert",
   "cond": {
    "textMatches": {
     "target": "hometax.cert.taxpayment.form.certDoc",
     "patternRef": "cert.doc.taxpayment"
    }
   },
   "code": "assert.input_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s19f",
   "type": "assert",
   "cond": {
    "all": [
     {
      "readbackEquals": {
       "fieldKey": "certPurpose",
       "ref": "$inputs.purpose"
      }
     },
     {
      "readbackEquals": {
       "fieldKey": "certSubmitTo",
       "ref": "$inputs.submitTo"
      }
     }
    ]
   },
   "code": "assert.input_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s20",
   "type": "gate",
   "card": "cert.confirm",
   "authorizes": [
    "s21"
   ],
   "waitMs": 600000
  },
  {
   "id": "s21",
   "type": "submit",
   "target": "hometax.cert.taxpayment.form.applyButton",
   "intent": "$intent.id",
   "verify": "s30",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s30",
   "type": "verify",
   "lookup": {
    "playbook": "hometax.cert.issued_list",
    "match": {
     "certDoc": "$readback.certDoc",
     "certPurpose": "$readback.certPurpose",
     "certSubmitTo": "$readback.certSubmitTo"
    },
    "window": "today",
    "baseline": "pre_gate_snapshot",
    "notCommittedPolicy": {
     "minElapsedMs": 60000,
     "lookups": 2
    },
    "bind": {
     "approvalNo": "issueNo"
    }
   },
   "on": {
    "committed": "s31",
    "not_committed": "s11",
    "unknown": "handoff"
   }
  },
  {
   "id": "s31",
   "type": "click",
   "target": "hometax.cert.taxpayment.result.printButton"
  },
  {
   "id": "s32",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.taxpayment.doc.root",
   "timeoutMs": 30000
  },
  {
   "id": "s33",
   "type": "save_pdf",
   "strategy": "print",
   "docType": "national_tax_cert"
  },
  {
   "id": "s34",
   "type": "end",
   "status": "success"
  },
  {
   "id": "s90",
   "type": "human",
   "kind": "captcha",
   "region": "hometax.captcha.image",
   "prompt": "captcha.prompt",
   "ttlMs": 90000
  },
  {
   "id": "s91",
   "type": "fill",
   "target": "hometax.captcha.input",
   "value": "$human.s90"
  },
  {
   "id": "s92",
   "type": "click",
   "target": "hometax.captcha.submit"
  },
  {
   "id": "s93",
   "type": "decide",
   "bundle": "screen_state_v2",
   "scope": "root",
   "loopGuard": {
    "max": 2
   },
   "on": {
    "logged_in": "s10",
    "login_required": "s3",
    "captcha": "handoff",
    "mfa_pending": "s5",
    "error": "handoff",
    "unknown": "handoff"
   }
  }
 ],
 "postconditions": [
  {
   "varSet": "issueNo"
  },
  {
   "artifact": "pdf"
  }
 ],
 "pacing": {
  "profile": "interactive"
 }
}