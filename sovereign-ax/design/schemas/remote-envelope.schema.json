{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-ax.dev/schemas/remote-envelope.schema.json",
  "title": "Sovereign AX Remote Envelope v1 (plaintext inside Noise transport; binary fields base64 here, CBOR bytes on the wire)",
  "type": "object",
  "required": ["v", "type", "id", "pairId", "from", "to", "seq", "ts", "ttl", "body"],
  "unevaluatedProperties": false,
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["hello", "cmd.run", "cmd.abort", "cmd.resume", "run.event", "gate.request", "gate.response", "human.request", "human.response", "file.offer", "query.documents", "query.result", "rotate.static", "close", "ping", "pong"]},
    "id": {"$ref": "#/$defs/ulid"},
    "pairId": {"$ref": "#/$defs/ulid"},
    "from": {"enum": ["desktop", "mobile"]},
    "to": {"enum": ["desktop", "mobile"]},
    "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "ts": {"type": "integer", "minimum": 0},
    "ttl": {"type": "integer", "minimum": 5, "maximum": 86400},
    "replyTo": {"anyOf": [{"$ref": "#/$defs/ulid"}, {"type": "null"}]},
    "body": {"type": "object"}
  },
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "stepRef": {"type": "string", "pattern": "^s[0-9]{1,3}[a-z]?$"},
    "b64": {"type": "string", "contentEncoding": "base64"},
    "sha256hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "hello"}}}, "then": {"properties": {"body": {"type": "object", "required": ["appVersion", "protocol", "deviceListVersion", "asyncSeqMax", "capabilities"], "additionalProperties": false, "properties": {"appVersion": {"type": "string", "maxLength": 32}, "protocol": {"const": 1}, "deviceListVersion": {"type": "integer"}, "asyncSeqMax": {"type": "integer"}, "capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 32}}}}}}},
    {"if": {"properties": {"type": {"const": "cmd.run"}}}, "then": {"properties": {"body": {"type": "object", "required": ["cmdId", "playbookId", "inputs"], "additionalProperties": false, "properties": {"cmdId": {"$ref": "#/$defs/ulid"}, "playbookId": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$", "maxLength": 80}, "inputs": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"enum": ["cmd.abort", "cmd.resume"]}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}}}}}},
    {"if": {"properties": {"type": {"const": "run.event"}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId", "event", "at"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}, "event": {"type": "string", "pattern": "^[a-z_.]+$", "maxLength": 40}, "at": {"type": "integer"}, "stepId": {"$ref": "#/$defs/stepRef"}, "code": {"type": "string", "maxLength": 40}, "status": {"type": "string", "maxLength": 32}}}}}},
    {"if": {"properties": {"type": {"const": "gate.request"}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId", "stepId", "reqId", "cardId", "fields", "actionHash", "challenge", "exp"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}, "stepId": {"$ref": "#/$defs/stepRef"}, "reqId": {"$ref": "#/$defs/ulid"}, "cardId": {"type": "string", "maxLength": 40}, "fields": {"type": "array", "maxItems": 24, "items": {"type": "object", "required": ["key", "value"], "additionalProperties": false, "properties": {"key": {"type": "string", "maxLength": 40}, "value": {"type": "string", "maxLength": 200}}}}, "actionHash": {"$ref": "#/$defs/sha256hex"}, "challenge": {"$ref": "#/$defs/b64", "maxLength": 44}, "exp": {"type": "integer"}}}}}},
    {"if": {"properties": {"type": {"const": "gate.response"}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId", "stepId", "reqId", "decision", "actionHash", "sig"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}, "stepId": {"$ref": "#/$defs/stepRef"}, "reqId": {"$ref": "#/$defs/ulid"}, "decision": {"enum": ["approve", "deny"]}, "actionHash": {"$ref": "#/$defs/sha256hex"}, "sig": {"$ref": "#/$defs/b64", "maxLength": 128}, "sigAlg": {"enum": ["ed25519", "p256"]}}}}}},
    {"if": {"properties": {"type": {"const": "human.request"}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId", "stepId", "reqId", "kind", "prompt", "ttl"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}, "stepId": {"$ref": "#/$defs/stepRef"}, "reqId": {"$ref": "#/$defs/ulid"}, "kind": {"enum": ["captcha", "otp", "secret", "manual"]}, "prompt": {"type": "string", "maxLength": 200}, "imageChunks": {"type": "array", "maxItems": 13, "items": {"$ref": "#/$defs/b64", "maxLength": 21848}}, "imageSha256": {"$ref": "#/$defs/sha256hex"}, "ttl": {"type": "integer", "minimum": 10, "maximum": 600}, "vaultChallenge": {"$ref": "#/$defs/b64", "maxLength": 44}, "origin": {"type": "string", "maxLength": 100}, "secretKind": {"enum": ["cert_password", "portal_password", "security_card"]}},
      "allOf": [{"if": {"properties": {"kind": {"const": "secret"}}}, "then": {"required": ["vaultChallenge", "origin", "secretKind"], "not": {"required": ["imageChunks"]}}}, {"if": {"properties": {"kind": {"const": "captcha"}}}, "then": {"required": ["imageChunks", "imageSha256"]}}]}}}},
    {"if": {"properties": {"type": {"const": "human.response"}}}, "then": {"properties": {"body": {"type": "object", "required": ["runId", "stepId", "reqId"], "additionalProperties": false, "properties": {"runId": {"$ref": "#/$defs/ulid"}, "stepId": {"$ref": "#/$defs/stepRef"}, "reqId": {"$ref": "#/$defs/ulid"}, "value": {"type": "string", "maxLength": 64}, "sealed": {"$ref": "#/$defs/b64", "maxLength": 1024}}, "oneOf": [{"required": ["value"]}, {"required": ["sealed"]}]}}}},
    {"if": {"properties": {"type": {"const": "file.offer"}}}, "then": {"properties": {"body": {"type": "object", "required": ["docId", "docType", "bytes", "blobId", "wDEK"], "additionalProperties": false, "properties": {"docId": {"$ref": "#/$defs/ulid"}, "docType": {"type": "string", "pattern": "^[a-z_]+$", "maxLength": 40}, "bytes": {"type": "integer", "minimum": 1}, "blobId": {"$ref": "#/$defs/ulid"}, "wDEK": {"$ref": "#/$defs/b64", "maxLength": 128}}}}}},
    {"if": {"properties": {"type": {"const": "query.documents"}}}, "then": {"properties": {"body": {"type": "object", "additionalProperties": false, "properties": {"docType": {"type": "string", "pattern": "^[a-z_]+$"}, "expiresBefore": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}}}}},
    {"if": {"properties": {"type": {"const": "query.result"}}}, "then": {"properties": {"body": {"type": "object", "required": ["items"], "additionalProperties": false, "properties": {"items": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["docId", "docType"], "additionalProperties": false, "properties": {"docId": {"$ref": "#/$defs/ulid"}, "docType": {"type": "string"}, "issuedAt": {"type": "string"}, "expiresAt": {"type": "string"}, "displayName": {"type": "string", "maxLength": 80}}}}}}}}},
    {"if": {"properties": {"type": {"const": "rotate.static"}}}, "then": {"properties": {"body": {"type": "object", "required": ["newStatic", "sig"], "additionalProperties": false, "properties": {"newStatic": {"$ref": "#/$defs/b64", "maxLength": 44}, "sig": {"$ref": "#/$defs/b64", "maxLength": 128}}}}}},
    {"if": {"properties": {"type": {"enum": ["close", "ping", "pong"]}}}, "then": {"properties": {"body": {"type": "object", "additionalProperties": false, "properties": {}}}}}
  ]
}
